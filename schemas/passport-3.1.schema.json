            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "valid_from": {
          "default": "",
          "title": "Valid From",
          "type": "string"
