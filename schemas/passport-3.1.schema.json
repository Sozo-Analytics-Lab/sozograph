      "title": "Stamp",
      "type": "object"
    },
    "Visa": {
      "additionalProperties": true,
      "description": "One agent's permission to read and write part of a passport.\n\nThe secret token never touches the file; only its SHA-256 does. The token\nis available once, on the object `issue()` returns.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
