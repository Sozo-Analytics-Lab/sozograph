    "Stamp": {
      "additionalProperties": true,
      "description": "One write to a log-backed passport.\n\nThe stamp log is the source of truth of a Passport 3.1 file. Every section\nis a deterministic projection of it, so two replicas holding the same\nstamps hold the same beliefs. `id` is a content address; `admission`,\n`sig` and `redacted` sit outside it, because they are the receiving\nreplica's verdict, its attestation and the holder's erasure, joined on merge.",
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "op": {
          "default": "assert",
          "enum": [
            "assert",
            "supersede",
            "correct",
            "retract",
            "confirm",
            "forget",
            "expire"
          ],
          "title": "Op",
          "type": "string"
        },
        "section": {
          "default": "",
