    "Episode": {
      "additionalProperties": true,
      "description": "What happened, and when.\n\nFacts answer \"what is true now\". A flat key-value belief state throws away\neverything else by construction, which is fatal on multi-hop and temporal\nquestions (\"what did she say about the painting in session 4\"). Episodes\nare compact per-segment summaries produced by the same extraction call, so\nthey cost no extra API request.\n\nThey are also what keeps retrieval honest: the belief state is small enough\nto inject in full, so only episodes are ever ranked, and a retrieval miss\ndegrades episodic recall rather than losing a fact outright.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "stamp_ids": {
          "items": {
            "type": "string"
          },
          "title": "Stamp Ids",
          "type": "array"
        },
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "origin": {
          "default": "",
          "title": "Origin",
          "type": "string"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "valid_from": {
          "default": "",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "default": "",
          "title": "Valid Until",
          "type": "string"
        },
        "sensitivity": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
