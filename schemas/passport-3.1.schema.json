          "type": "string"
        },
        "claim": {
          "additionalProperties": true,
          "title": "Claim",
          "type": "object"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "visa": {
          "default": "",
          "title": "Visa",
          "type": "string"
        },
        "origin": {
          "default": "agent_inferred",
          "enum": [
            "third_party",
            "tool_result",
            "imported",
            "agent_inferred",
            "user_confirmed",
            "user_direct"
          ],
          "title": "Origin",
          "type": "string"
        },
        "hlc": {
          "default": "",
          "title": "Hlc",
          "type": "string"
        },
        "seen": {
          "default": "",
          "title": "Seen",
          "type": "string"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "erase_sources": {
          "items": {
            "type": "string"
          },
          "title": "Erase Sources",
          "type": "array"
        },
        "admission": {
          "default": "accepted",
          "enum": [
            "accepted",
            "quarantined"
          ],
          "title": "Admission",
