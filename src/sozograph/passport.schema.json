  "additionalProperties": true,
  "description": "A portable memory snapshot.\n\nThis is the whole product: a small JSON object holding what is true\n(`facts`), what is wanted (`prefs`), who and what is involved (`entities`),\nwhat is unfinished (`open_loops`), what changed (`contradictions`), what\nhappened (`episodes`), and the atomic details worth recalling\n(`observations`). It moves between runtimes, databases, and client\napplications as plain JSON, with no vector store to migrate and no\nembedding model to match.",
  "properties": {
    "version": {
      "type": "string",
      "const": "2.2",
      "default": "2.2"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Key"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "prefs": {
      "items": {
        "$ref": "#/$defs/Preference"
      },
      "title": "Prefs",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "open_loops": {
      "items": {
        "$ref": "#/$defs/OpenLoop"
      },
      "title": "Open Loops",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/Episode"
      },
      "title": "Episodes",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
