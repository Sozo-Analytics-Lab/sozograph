# Pick one. Whichever key is set is used; SOZOGRAPH_PROVIDER wins over all of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Or name the provider explicitly: "openai", "anthropic:claude-opus-5",
# "gemini:gemini-2.5-flash", "ollama:llama3.2", "litellm:bedrock/anthropic.claude-opus-5"
# SOZOGRAPH_PROVIDER=openai:gpt-4o-mini
# SOZOGRAPH_MODEL=

# Characters of rendered context per prompt.
SOZOGRAPH_DEFAULT_CONTEXT_BUDGET=3000

# Truncation applied to a single interaction before extraction.
SOZOGRAPH_MAX_INTERACTION_CHARS=4000

# Summarize database objects whose text stringifies into noise.
# Never applies to conversational text.
SOZOGRAPH_ENABLE_FALLBACK_SUMMARIZER=true

# Local models. Only needed if the host is not the default.
# OLLAMA_HOST=http://127.0.0.1:11434
